          <dc:Bounds height="28.0" width="51.357421875" x="381.0390625" y="306.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Start_1" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Start_1">
        <dc:Bounds height="36.0" width="36.0" x="24.017578125" y="124.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Start_1">
