      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Task_refund" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Task_refund">
        <dc:Bounds height="80.0" width="100.0" x="0.0" y="394.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Task_refund">
          <dc:Bounds height="28.0" width="50.6953125" x="24.65234375" y="489.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Task_ship" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Task_ship">
        <dc:Bounds height="80.0" width="100.0" x="174.03515625" y="102.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Task_ship">
          <dc:Bounds height="20.0" width="58.025390625" x="195.0224609375" y="295.0"/>
        </bpmndi:BPMNLabel>
