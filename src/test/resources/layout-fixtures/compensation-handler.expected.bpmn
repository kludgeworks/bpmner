      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Boundary_compensate" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Boundary_compensate">
        <dc:Bounds height="36.0" width="36.0" x="206.03515625" y="156.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Boundary_compensate">
          <dc:Bounds height="20.0" width="82.716796875" x="182.6767578125" y="275.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="bpmner-diagram-header" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_bpmner-diagram-header">
