      <bpmndi:BPMNEdge bioc:stroke="#16181d" bpmnElement="MsgFlow_out" color:border-color="#16181d" id="BPMNEdge_MsgFlow_out">
        <di:waypoint x="238.0" y="112.0"/>
        <di:waypoint x="238.0" y="255.0"/>
