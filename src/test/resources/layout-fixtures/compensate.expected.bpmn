        <dc:Bounds height="34.0" width="310.791015625" x="17.349609375" y="68.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="bpmner-diagram-notes" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_bpmner-diagram-notes">
        <dc:Bounds height="34.0" width="341.453125" x="17.349609375" y="34.0"/>
