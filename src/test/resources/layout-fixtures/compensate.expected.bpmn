      <bpmndi:BPMNShape bpmnElement="Boundary_error" id="BPMNShape_Boundary_error">
        <dc:Bounds height="36.0" width="36.0" x="394.69921875" y="66.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Boundary_error">
          <dc:Bounds height="20.0" width="86.712890625" x="369.3427734375" y="175.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_1" id="BPMNEdge_Flow_1">
