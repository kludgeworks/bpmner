      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Start_1" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Start_1">
        <dc:Bounds height="36.0" width="36.0" x="17.349609375" y="124.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Start_1">
          <dc:Bounds height="20.0" width="70.69921875" x="0.0" y="175.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Task_charge" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Task_charge">
        <dc:Bounds height="80.0" width="100.0" x="160.69921875" y="102.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Task_charge">
          <dc:Bounds height="20.0" width="68.701171875" x="176.3486328125" y="197.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Task_ship" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Task_ship">
        <dc:Bounds height="80.0" width="100.0" x="350.69921875" y="102.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_Task_ship">
          <dc:Bounds height="20.0" width="58.025390625" x="371.6865234375" y="295.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="Boundary_error" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_Boundary_error">
        <dc:Bounds height="36.0" width="36.0" x="382.69921875" y="156.0"/>
