        <dc:Bounds height="36.0" width="36.0" x="565.3818359375" y="255.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_End_compensate">
          <dc:Bounds height="20.0" width="85.365234375" x="540.69921875" y="306.0"/>
        </bpmndi:BPMNLabel>
