      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bioc:stroke="#16181d" bpmnElement="Flow_1" color:border-color="#16181d" id="BPMNEdge_Flow_1">
        <di:waypoint x="48.0" y="52.0"/>
        <di:waypoint x="138.0" y="52.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bioc:stroke="#16181d" bpmnElement="Flow_2" color:border-color="#16181d" id="BPMNEdge_Flow_2">
        <di:waypoint x="618.0" y="65.0"/>
        <di:waypoint x="708.0" y="65.0"/>
