  <bpmn:collaboration id="Collab_lanes_branch_rejoin" isClosed="false">

    <bpmn:participant id="Participant_1" name="Change Request Handling" processRef="Process_1"/>

  </bpmn:collaboration>

  <bpmn:process id="Process_1" isClosed="false" isExecutable="true" name="Change Request Handling" processType="None">

    <bpmn:laneSet id="LaneSet_1">

      <bpmn:lane id="Lane_top" name="Requester">

        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>

        <bpmn:flowNodeRef>Task_prepare</bpmn:flowNodeRef>

        <bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef>

        <bpmn:flowNodeRef>Task_review</bpmn:flowNodeRef>

        <bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef>

        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>

      </bpmn:lane>

      <bpmn:lane id="Lane_lower" name="Approver">

        <bpmn:flowNodeRef>Task_approve</bpmn:flowNodeRef>

      </bpmn:lane>

    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" isInterrupting="true" name="Request Submitted" parallelMultiple="false">

      <bpmn:outgoing>Flow_1</bpmn:outgoing>

    </bpmn:startEvent>

    <bpmn:userTask completionQuantity="1" id="Task_prepare" implementation="##unspecified" isForCompensation="false" name="Prepare Request" startQuantity="1">

      <bpmn:incoming>Flow_1</bpmn:incoming>

      <bpmn:outgoing>Flow_2</bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:exclusiveGateway gatewayDirection="Unspecified" id="Gw_split" name="Needs Approval?">

      <bpmn:incoming>Flow_2</bpmn:incoming>

      <bpmn:outgoing>Flow_3</bpmn:outgoing>

      <bpmn:outgoing>Flow_4</bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <bpmn:userTask completionQuantity="1" id="Task_review" implementation="##unspecified" isForCompensation="false" name="Review Request" startQuantity="1">

      <bpmn:incoming>Flow_3</bpmn:incoming>

      <bpmn:outgoing>Flow_5</bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:userTask completionQuantity="1" id="Task_approve" implementation="##unspecified" isForCompensation="false" name="Approve Request" startQuantity="1">

      <bpmn:incoming>Flow_4</bpmn:incoming>

      <bpmn:outgoing>Flow_6</bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:exclusiveGateway gatewayDirection="Unspecified" id="Gw_join" name="Requirements Met?">

      <bpmn:incoming>Flow_5</bpmn:incoming>

      <bpmn:incoming>Flow_6</bpmn:incoming>

      <bpmn:outgoing>Flow_7</bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_1" name="Request Closed">

      <bpmn:incoming>Flow_7</bpmn:incoming>

    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_prepare"/>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_prepare" targetRef="Gw_split"/>

    <bpmn:sequenceFlow id="Flow_3" name="No" sourceRef="Gw_split" targetRef="Task_review"/>

    <bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="Gw_split" targetRef="Task_approve"/>

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_review" targetRef="Gw_join"/>

    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_approve" targetRef="Gw_join"/>

    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_join" targetRef="End_1"/>
    <textAnnotation id="bpmner-diagram-header" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
      <text>Change Request Handling (Participant_1)</text>
