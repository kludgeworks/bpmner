<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_boundary_non_interrupting" targetNamespace="https://groknull.dev/bpmner">
  <bpmn:process id="Process_1" name="Boundary Non-Interrupting" isExecutable="true">
    <bpmn:startEvent id="Start_1" name="Review Started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_review" name="Review Application">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_normal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_reminder" name="Overdue" attachedToRef="Task_review" cancelActivity="false">
      <bpmn:outgoing>Flow_reminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_1" name="Reviewed">
      <bpmn:incoming>Flow_normal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_notify" name="Send Reminder">
      <bpmn:incoming>Flow_reminder</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_reminder" name="Reminder Sent">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_review"/>
    <bpmn:sequenceFlow id="Flow_normal" sourceRef="Task_review" targetRef="End_1"/>
    <bpmn:sequenceFlow id="Flow_reminder" sourceRef="Boundary_reminder" targetRef="Task_notify"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_notify" targetRef="End_reminder"/>
  </bpmn:process>
</bpmn:definitions>
