      <bpmndi:BPMNShape bioc:fill="#ffffff" bioc:stroke="#16181d" bpmnElement="SubProcess_handler" color:background-color="#ffffff" color:border-color="#16181d" id="BPMNShape_SubProcess_handler" isExpanded="true">
        <dc:Bounds height="235.0" width="520.736328125" x="0.0" y="277.0"/>
