  <bpmn:error errorCode="ORDER_FAILED" id="Error_1" name="Order Failed"/>

  <bpmn:process id="Process_1" isClosed="false" isExecutable="true" name="Event Subprocess" processType="None">

    <bpmn:startEvent id="Start_1" isInterrupting="true" name="Order Received" parallelMultiple="false">

      <bpmn:outgoing>Flow_1</bpmn:outgoing>

    </bpmn:startEvent>

    <bpmn:serviceTask completionQuantity="1" id="Task_process" implementation="##WebService" isForCompensation="false" name="Process Order" startQuantity="1">

      <bpmn:incoming>Flow_1</bpmn:incoming>

      <bpmn:outgoing>Flow_2</bpmn:outgoing>

    </bpmn:serviceTask>

    <bpmn:endEvent id="End_1" name="Order Shipped">

      <bpmn:incoming>Flow_2</bpmn:incoming>

    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_process"/>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_process" targetRef="End_1"/>

    <bpmn:subProcess completionQuantity="1" id="SubProcess_handler" isForCompensation="false" name="Handle Order Failure" startQuantity="1" triggeredByEvent="true">

      <bpmn:startEvent id="Start_handler" isInterrupting="true" name="On Failure" parallelMultiple="false">

        <bpmn:outgoing>Flow_handler_1</bpmn:outgoing>

        <bpmn:errorEventDefinition errorRef="Error_1" id="ErrorDef_1"/>

      </bpmn:startEvent>

      <bpmn:serviceTask completionQuantity="1" id="Task_notify" implementation="##WebService" isForCompensation="false" name="Notify Customer" startQuantity="1">

        <bpmn:incoming>Flow_handler_1</bpmn:incoming>

        <bpmn:outgoing>Flow_handler_2</bpmn:outgoing>

      </bpmn:serviceTask>

      <bpmn:endEvent id="End_handler" name="Failure Handled">

        <bpmn:incoming>Flow_handler_2</bpmn:incoming>

      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_handler_1" sourceRef="Start_handler" targetRef="Task_notify"/>

      <bpmn:sequenceFlow id="Flow_handler_2" sourceRef="Task_notify" targetRef="End_handler"/>

    </bpmn:subProcess>

  </bpmn:process>
