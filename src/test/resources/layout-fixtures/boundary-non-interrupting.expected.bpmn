<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" expressionLanguage="http://www.w3.org/1999/XPath" id="Definitions_boundary_non_interrupting" targetNamespace="https://groknull.dev/bpmner" typeLanguage="http://www.w3.org/2001/XMLSchema">

  <bpmn:process id="Process_1" isClosed="false" isExecutable="true" name="Boundary Non-Interrupting" processType="None">

    <bpmn:startEvent id="Start_1" isInterrupting="true" name="Review Started" parallelMultiple="false">

      <bpmn:outgoing>Flow_1</bpmn:outgoing>

    </bpmn:startEvent>

    <bpmn:userTask completionQuantity="1" id="Task_review" implementation="##unspecified" isForCompensation="false" name="Review Application" startQuantity="1">

      <bpmn:incoming>Flow_1</bpmn:incoming>

      <bpmn:outgoing>Flow_normal</bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:boundaryEvent attachedToRef="Task_review" cancelActivity="false" id="Boundary_reminder" name="Overdue" parallelMultiple="false">

      <bpmn:outgoing>Flow_reminder</bpmn:outgoing>

      <bpmn:timerEventDefinition id="TimerDef_1"/>

    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End_1" name="Reviewed">

      <bpmn:incoming>Flow_normal</bpmn:incoming>

    </bpmn:endEvent>

    <bpmn:serviceTask completionQuantity="1" id="Task_notify" implementation="##WebService" isForCompensation="false" name="Send Reminder" startQuantity="1">

      <bpmn:incoming>Flow_reminder</bpmn:incoming>

      <bpmn:outgoing>Flow_2</bpmn:outgoing>

    </bpmn:serviceTask>

    <bpmn:endEvent id="End_reminder" name="Reminder Sent">

      <bpmn:incoming>Flow_2</bpmn:incoming>

    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_review"/>

    <bpmn:sequenceFlow id="Flow_normal" sourceRef="Task_review" targetRef="End_1"/>

    <bpmn:sequenceFlow id="Flow_reminder" sourceRef="Boundary_reminder" targetRef="Task_notify"/>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_notify" targetRef="End_reminder"/>

  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="Process_1" id="BPMNPlane_1">
