    <bpmn:serviceTask completionQuantity="1" id="Task_between2_compensate" implementation="##WebService" isForCompensation="true" name="Reverse Pricing" startQuantity="1"/>

    <bpmn:subProcess completionQuantity="1" id="SubProcess_C" isForCompensation="false" name="Notify Customer" startQuantity="1" triggeredByEvent="false">

