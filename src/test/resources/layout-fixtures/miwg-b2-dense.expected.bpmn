      <bpmn:userTask completionQuantity="1" id="Task_B2" implementation="##unspecified" isForCompensation="false" name="Reserve" startQuantity="1">

        <bpmn:incoming>SFlow_B3</bpmn:incoming>

        <bpmn:outgoing>SFlow_B5</bpmn:outgoing>

      </bpmn:userTask>

      <bpmn:userTask completionQuantity="1" id="Task_B3" implementation="##unspecified" isForCompensation="false" name="Backorder" startQuantity="1">

