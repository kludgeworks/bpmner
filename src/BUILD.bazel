load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@rules_java//java:defs.bzl", "java_library")
load("@rules_kotlin//kotlin:core.bzl", "kt_compiler_plugin", "kt_plugin_cfg")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_library")
load("@rules_kotlin//kotlin:lint.bzl", "ktlint_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_spring//springboot:springboot.bzl", "springboot")
load("@tar.bzl//tar:tar.bzl", "tar")
load("//tools/kotlin:spring.bzl", "SPRING_OPEN_ANNOTATIONS", "spring_allopen_plugins")

package(default_visibility = ["//visibility:public"])

exports_files(["main/kotlin/dev/groknull/bpmner/core/BpmnDomain.kt"])

# Kotlin Compiler Plugins
kt_compiler_plugin(
    name = "allopen_base",
    id = "org.jetbrains.kotlin.allopen",
    deps = ["@rules_kotlin//kotlin/compiler:allopen-compiler-plugin"],
)

[kt_plugin_cfg(
    name = "allopen_" + a.split(".")[-1].lower(),
    options = {"annotation": [a]},
    plugin = ":allopen_base",
) for a in SPRING_OPEN_ANNOTATIONS]

java_library(
    name = "web_bundle_resources",
    resource_strip_prefix = "web/dist",
    resources = [
        "//web:bundle",
        "//web:index_html",
        "//web:style_css",
    ],
)

java_library(
    name = "web_static_resources",
    resource_strip_prefix = "web/src",
    resources = ["//web:static_assets"],
)

java_library(
    name = "preview_bundle_resources",
    resource_strip_prefix = "web/dist",
    resources = ["//web:preview_bundle"],
)

java_library(
    name = "web_version_resource",
    resource_strip_prefix = "web/dist",
    resources = ["//web:version_json"],
)

filegroup(
    name = "bazelrun_samples",
    srcs = [
        "//:toast-process.txt",
    ],
)

filegroup(
    name = "analysis_srcs",
    srcs = glob(["main/kotlin/**/*.kt"]),
)

kt_jvm_library(
    name = "bpmner_core",
    srcs = glob(["main/kotlin/**/*.kt"]),
    plugins = spring_allopen_plugins(),
    resources = glob(["main/resources/**"]),
    deps = [
        ":preview_bundle_resources",
        ":web_bundle_resources",
        ":web_static_resources",
        ":web_version_resource",
        "//linter/pkl:pkl_runtime_resources",
        "@maven//:com_embabel_agent_embabel_agent_starter_anthropic",
        "@maven//:com_embabel_agent_embabel_agent_starter_gemini",
        "@maven//:com_embabel_agent_embabel_agent_starter_mistral_ai",
        "@maven//:com_embabel_agent_embabel_agent_starter_observability",
        "@maven//:com_embabel_agent_embabel_agent_starter_openai",
        "@maven//:com_embabel_agent_embabel_agent_starter_shell",
        "@maven//:com_embabel_agent_embabel_agent_starter_webmvc",
        "@maven//:io_micrometer_micrometer_registry_prometheus",
        "@maven//:io_micrometer_micrometer_tracing_bridge_otel",
        "@maven//:io_opentelemetry_opentelemetry_exporter_otlp",
        "@maven//:io_projectreactor_reactor_core",
        "@maven//:org_apache_opennlp_opennlp_tools",
        "@maven//:org_camunda_bpm_model_camunda_bpmn_model",
        "@maven//:org_eclipse_elk_org_eclipse_elk_alg_layered",
        "@maven//:org_eclipse_xtext_org_eclipse_xtext_xbase_lib",
        "@maven//:org_jetbrains_kotlin_kotlin_reflect",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jmolecules_integrations_jmolecules_spring",
        "@maven//:org_jmolecules_integrations_jmolecules_starter_ddd",
        "@maven//:org_jmolecules_jmolecules_cqrs_architecture",
        "@maven//:org_jmolecules_jmolecules_events",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_pkl_lang_pkl_config_java",
        "@maven//:org_pkl_lang_pkl_config_kotlin",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:org_springframework_boot_spring_boot_loader",
        "@maven//:org_springframework_boot_spring_boot_starter",
        "@maven//:org_springframework_boot_spring_boot_starter_actuator",
        "@maven//:org_springframework_boot_spring_boot_starter_web",
        "@maven//:org_springframework_modulith_spring_modulith_starter_core",
        "@rules_java//java/runfiles",
    ],
)

springboot(
    name = "bpmner_app",
    bazelrun_data = [":bazelrun_samples"],
    boot_app_class = "dev.groknull.bpmner.BpmnerApplicationKt",
    boot_launcher_class = "org.springframework.boot.loader.launch.JarLauncher",
    java_library = ":bpmner_core",
)

tar(
    name = "bpmner_jar_layer",
    srcs = [":bpmner_app.jar"],
    mtree = [
        "app type=dir",
        "app/bpmner.jar type=file content=$(location :bpmner_app.jar)",
    ],
)

oci_image(
    name = "bpmner_image_amd64",
    base = "@distroless_java21_debian12_linux_amd64",
    cmd = ["/app/bpmner.jar"],
    entrypoint = [
        "/usr/bin/java",
        "-jar",
    ],
    tars = [":bpmner_jar_layer"],
)

oci_image(
    name = "bpmner_image_arm64",
    base = "@distroless_java21_debian12_linux_arm64_v8",
    cmd = ["/app/bpmner.jar"],
    entrypoint = [
        "/usr/bin/java",
        "-jar",
    ],
    tars = [":bpmner_jar_layer"],
)

oci_image_index(
    name = "bpmner_image",
    images = [
        ":bpmner_image_amd64",
        ":bpmner_image_arm64",
    ],
)

expand_template(
    name = "bpmner_image_tags",
    out = "bpmner_image_tags.txt",
    stamp_substitutions = {"0.0.0": "{{BUILD_EMBED_LABEL}}"},
    template = [
        "0.0.0",
        "latest",
    ],
)

oci_push(
    name = "push_bpmner_image",
    image = ":bpmner_image",
    remote_tags = ":bpmner_image_tags",
    repository = "ghcr.io/kludgeworks/bpmner",
)

# Dev-only plain JVM binary so IntelliJ's Bazel plugin renders a run/debug gutter
# action on `fun main`. Reuses the :bpmner_core library; it does NOT replicate the
# Spring Boot launcher/profile wiring of :bpmner_app — use :bpmner_app for the
# packaged artifact, this purely for fast in-IDE run/debug.
kt_jvm_binary(
    name = "bpmner_dev",
    main_class = "dev.groknull.bpmner.BpmnerApplicationKt",
    runtime_deps = [":bpmner_core"],
)

ktlint_test(
    name = "ktlint_check",
    srcs = glob(["main/kotlin/**/*.kt"]),
    config = "//:ktlint_config",
)
