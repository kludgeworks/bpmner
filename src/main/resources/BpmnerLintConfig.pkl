module dev.groknull.bpmner.pkl.BpmnerLintConfig

typealias Severity = "error" | "warning" | "info" | "off"

/// Lint configuration scaffold packaged with the runtime resources.
/// `bpmner.pkl` amends this module and is evaluated once at startup for convention lists.
profile: String = "recommended"

severityOverrides: Mapping<String, Severity> =
  if (profile == "recommended")
    new {
      ["act-verb-object-name"] = "off"
      ["act-activity-label-capitalization"] = "off"
      ["name-no-element-type-words"] = "off"
      ["name-uncommon-abbreviations"] = "off"
    }
  else
    new {}

discouragedLeadingVerbs: List<String> = List("handle", "manage", "process", "perform", "do")

elementTypeWords: List<String> = List("activity", "process", "event")

allowedAcronyms: List<String> = List("BPMN", "ACME", "SLA", "API", "IT")

discouragedBpmnTypes: List<String> =
  List(
    "bpmn:Choreography",
    "bpmn:ChoreographyTask",
    "bpmn:SubChoreography",
    "bpmn:CallChoreography",
    "bpmn:Conversation",
    "bpmn:ConversationLink",
    "bpmn:ConversationAssociation",
    "bpmn:Transaction",
    "bpmn:DataObject",
    "bpmn:DataObjectReference",
    "bpmn:DataStore",
    "bpmn:DataStoreReference",
    "bpmn:DataInputAssociation",
    "bpmn:DataOutputAssociation",
  )

styleGuideDiscouragedBpmnTypes: List<String> =
  List(
    "bpmn:Choreography",
    "bpmn:ChoreographyTask",
    "bpmn:SubChoreography",
    "bpmn:CallChoreography",
    "bpmn:Conversation",
    "bpmn:ConversationLink",
    "bpmn:ConversationAssociation",
    "bpmn:Transaction",
    "bpmn:DataObject",
    "bpmn:DataObjectReference",
    "bpmn:DataStore",
    "bpmn:DataStoreReference",
    "bpmn:DataInputAssociation",
    "bpmn:DataOutputAssociation",
    "bpmn:UserTask",
    "bpmn:ServiceTask",
    "bpmn:ManualTask",
    "bpmn:ScriptTask",
    "bpmn:BusinessRuleTask",
    "bpmn:SendTask",
    "bpmn:ReceiveTask",
    "bpmn:ComplexGateway",
  )

abbreviationReplacements: Mapping<String, String> = new {
  ["REQ"] = "request"
  ["RESP"] = "response"
  ["AUTH"] = "authentication"
  ["CFG"] = "configuration"
  ["MSG"] = "message"
  ["DOC"] = "document"
  ["ITBL"] = "itinerary block"
}

/// Per-shape visual style override. All properties are optional; unset properties fall back
/// to [ThemeConfig]'s global defaults.
class ShapeStyle {
  fill: String?
  stroke: String?
  fontColor: String?
  fontName: String?
  fontSize: Number?
  fontWeight: String?
}

/// Global default visual theme applied to generated BPMN diagrams, with optional per-BPMN-type
/// overrides. Matches the `bpmner` web UI's `--sev-info` / `--ink` / `--paper` design tokens.
class ThemeConfig {
  primaryColor: String = "#2b6cb0"
  secondaryColor: String = "#16181d"
  backgroundColor: String = "#ffffff"
  fontName: String?
  fontSize: Number?
  shapeOverrides: Mapping<String, ShapeStyle> = new {}
}

theme: ThemeConfig = new {}
