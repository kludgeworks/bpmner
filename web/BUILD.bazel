load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@aspect_bazel_lib//lib:testing.bzl", "assert_contains")
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@bazel_sonarqube//:defs.bzl", "sonarqube")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/js:test.bzl", "bpmner_node_test")
load("//tools/js:ts.bzl", "bpmner_ts_configs", "bpmner_ts_project")
load("//web:version.bzl", "bpmner_module_version", "version_json")

package(default_visibility = [
    "//:__pkg__",
    "//src:__subpackages__",
])

# Single sonarqube rule (no sq_project wrapper) — each package IS its own SonarCloud
# project, so the multi-module aggregation that sq_project enables is unused here.
# Having both rules in one package fails to load because each generates the same
# `sonar-project.properties` output file.
#
# Visibility is explicitly public on this rule (overriding the restricted package
# default) so the SonarCloud workflow can `bazel run //web:sonar` from outside
# the package. The package-level default stays restricted to avoid leaking the
# bundler / asset targets to the rest of the build graph.
sonarqube(
    name = "sonar",
    srcs = glob(["src/**/*.ts"]),
    project_key = "kludgeworks_bpmner_web",
    project_name = "bpmner Web",
    scm_info = ["//:git_info"],
    visibility = ["//visibility:public"],
)

# Link the standalone web package's node_modules
npm_link_all_packages(name = "node_modules")

WEB_SRCS = glob(
    [
        "src/**/*.ts",
        "types/**/*.d.ts",
    ],
    allow_empty = True,
)

WEB_TEST_SRCS = glob(["test/**/*.ts"])

WEB_STATIC_ASSETS = glob(
    ["src/static/**/*"],
    exclude = [
        "src/static/index.html",
        "src/static/style.css",
    ],
)

# The release version, single-sourced from MODULE.bazel's module(version = ...)
# — reused below to version-suffix the app's own JS/CSS filenames so a CDN in
# front of the deployed app can never serve a stale bundle at a URL that a
# newer release also uses (issue #659).
_VERSION = bpmner_module_version()

WEB_TS_DEPS = [
    "//:node_modules/@types/jsdom",
    "//:node_modules/@types/node",
    "//:node_modules/axe-core",
    "//:node_modules/bpmn-js",
    "//:node_modules/jsdom",
    "//:node_modules/preact",
]

bpmner_ts_configs()

bpmner_ts_project(
    name = "ts",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    out_dir = "tsc",
    resolve_json_module = True,
    tsconfig = ":tsconfig_bazel",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "preview_helpers_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/preview-helpers.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "stage_rail_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/stage-rail.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "snapshot_import_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/snapshot-import.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "result_bar_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/result-bar.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "stream_settle_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/stream-settle.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "clarify_form_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/clarify-form.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "run_update_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/run-update.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "app_helpers_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/app-helpers.test.ts",
    deps = WEB_TS_DEPS,
)

# jsdom is a large CJS package with runtime resource loading that does not
# survive esbuild bundling, so it is marked external here and resolved from
# node_modules at runtime (ADR-ss-006 / PLAN ss-5 risk R-jsdom-bundle).
bpmner_node_test(
    name = "studio_a11y_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/studio-a11y.test.ts",
    external = ["jsdom"],
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "version_footer_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/version-footer.test.ts",
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "canvas_viewport_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/canvas-viewport.test.ts",
    external = [
        "../src/canvas-viewport",
        "jsdom",
    ],
    extra_data = [":canvas_viewport_module"],
    deps = WEB_TS_DEPS,
)

bpmner_node_test(
    name = "diagram_export_test",
    srcs = WEB_SRCS + WEB_TEST_SRCS,
    entry_point = "test/diagram-export.test.ts",
    external = [
        "../src/diagram-export",
        "jsdom",
    ],
    extra_data = [":diagram_export_module"],
    deps = WEB_TS_DEPS,
)

esbuild(
    name = "canvas_viewport_module",
    srcs = WEB_SRCS,
    entry_point = "src/canvas-viewport.ts",
    format = "cjs",
    output = "dist/src/canvas-viewport.js",
    platform = "node",
    sourcemap = "inline",
    sources_content = True,
    target = "es2022",
    deps = WEB_TS_DEPS,
)

esbuild(
    name = "diagram_export_module",
    srcs = WEB_SRCS,
    entry_point = "src/diagram-export.ts",
    format = "cjs",
    output = "dist/src/diagram-export.js",
    platform = "node",
    sourcemap = "inline",
    sources_content = True,
    target = "es2022",
    deps = WEB_TS_DEPS,
)

esbuild(
    name = "bundle",
    srcs = WEB_SRCS,
    config = {
        "sourcemap": False,
    },
    entry_point = "src/app.ts",
    format = "iife",
    output = "dist/static/js/app-bundle-{}.js".format(_VERSION),
    platform = "browser",
    target = "es2022",
    deps = WEB_TS_DEPS,
)

esbuild(
    name = "preview_bundle",
    srcs = WEB_SRCS,
    config = {
        "sourcemap": False,
    },
    entry_point = "src/preview.ts",
    format = "esm",
    output = "dist/preview/preview-bundle.js",
    platform = "browser",
    target = "es2022",
    deps = WEB_TS_DEPS,
)

version_json(
    name = "version_json",
    out = "dist/static/version.json",
)

filegroup(
    name = "static_assets",
    srcs = WEB_STATIC_ASSETS,
)

# style.css isn't esbuild-bundled, so it needs its own versioned copy (see
# _VERSION above) to get the same stale-CDN protection as the JS bundle.
copy_file(
    name = "style_css",
    src = "src/static/style.css",
    out = "dist/static/style-{}.css".format(_VERSION),
)

# index.html's own markup is untouched: `href="style.css"` and
# `src="js/app-bundle.js"` are already unique, single-occurrence, exact-match
# substrings, so they're rewritten on the way from src/ to dist/ rather than
# needing placeholder tokens in the source file.
expand_template(
    name = "index_html",
    out = "dist/static/index.html",
    substitutions = {
        'href="style.css"': 'href="style-{}.css"'.format(_VERSION),
        'src="js/app-bundle.js"': 'src="js/app-bundle-{}.js"'.format(_VERSION),
    },
    template = "src/static/index.html",
)

# Build-time regression guard for issue #659: fails if index.html's script tag
# ever stops tracking the current release version (a reverted substitution, a
# reverted esbuild `output` rename, etc.).
assert_contains(
    name = "index_html_assert_contains",
    actual = ":index_html",
    expected = 'src="js/app-bundle-{}.js"'.format(_VERSION),
)
